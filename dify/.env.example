# Copy this file to dify/.env and fill in real values.
# dify/.env is git-ignored; never commit real credentials.

# --- seekdb (the database that stores the NPC long-term memory) -------------
# Any non-empty value works for the bundled docker-compose file.
SEEKDB_ROOT_PASSWORD=YOUR_SEEKDB_ROOT_PASSWORD
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_HTTP_PORT=2886
SEEKDB_USER=root
SEEKDB_TENANT=sys
SEEKDB_DATABASE=npc_memory
SEEKDB_CONNECT_TIMEOUT=10
SEEKDB_READ_TIMEOUT=20
SEEKDB_MEMORY_LIMIT=4G
SEEKDB_DATAFILE_SIZE=2G
SEEKDB_DATAFILE_NEXT=2G
SEEKDB_DATAFILE_MAXSIZE=16G

# --- memory service (the HTTP bridge the Dify workflow calls) --------------
MEMORY_SERVICE_PORT=8077
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8077

# --- Dify ------------------------------------------------------------------
# Base URL that the Dify HTTP Request node uses to reach the memory service.
# When Dify runs in docker compose on the same host, use the compose service
# name (http://memory-service:8077).  When Dify runs natively on Windows use
# http://127.0.0.1:8077.
MEMORY_SERVICE_BASE_URL=http://127.0.0.1:8077

# --- model provider --------------------------------------------------------
# The Dify app is configured in the Dify UI (Settings -> Model Provider).
# The workflow only needs a Chat model; any OpenAI-compatible endpoint works.
# Example for an OpenAI-compatible provider:
#   DIFY_MODEL_PROVIDER=openai_api_compatible
#   DIFY_MODEL_NAME=YOUR_MODEL_NAME
#   DIFY_API_KEY=YOUR_API_KEY
#   DIFY_API_BASE_URL=https://your-endpoint.example.com/v1
DIFY_MODEL_PROVIDER=YOUR_MODEL_PROVIDER
DIFY_MODEL_NAME=YOUR_MODEL_NAME
DIFY_API_KEY=YOUR_API_KEY
DIFY_API_BASE_URL=YOUR_API_BASE_URL
