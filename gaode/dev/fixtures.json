{
  "_about": "离线行为回归用的合成工具返回。响应字段按高德 MCP 实际 schema 构造：周边检索 pois[]（含 id/name/address/location/distance），步行路线 route.paths[]（distance 米、duration 秒，均为数字字符串），距离测量 results[].distance/duration。所有 POI 名称、坐标与数值均为合成数据，不对应真实营业场所，不得作为真实地点引用。",
  "scenarios": [
    {
      "id": "E",
      "title": "距离测量陷阱",
      "request": "我在杭州，起点坐标 120.150000,30.270000，想找家咖啡馆，步行不超过15分钟，最多2家，优先近一点的。",
      "tool_catalog": [
        "maps_around_search(keywords, location, radius) - 周边检索",
        "maps_distance(origins, destination, type) - 距离测量，type=1 表示步行测量",
        "maps_direction_walking_by_coordinates(origin, destination) - 步行路线规划"
      ],
      "tool_calls": [
        {
          "tool": "maps_around_search",
          "args": {"keywords": "咖啡馆", "location": "120.150000,30.270000", "radius": 3000},
          "response": {
            "status": "1",
            "info": "OK",
            "pois": [
              {"id": "B0FFSYN001", "name": "云栖咖啡(黄龙店)", "address": "西湖区黄龙路8号", "location": "120.156000,30.274000", "type": "餐饮服务;咖啡厅", "distance": "700"},
              {"id": "B0FFSYN002", "name": "巷子口咖啡", "address": "西湖区曙光路12号", "location": "120.161000,30.279000", "type": "餐饮服务;咖啡厅", "distance": "1200"},
              {"id": "B0FFSYN003", "name": "远山咖啡", "address": "拱墅区湖墅南路300号", "location": "120.200000,30.320000", "type": "餐饮服务;咖啡厅", "distance": "4800"}
            ]
          }
        },
        {
          "tool": "maps_distance",
          "args": {"origins": "120.150000,30.270000", "destination": "120.156000,30.274000", "type": "1"},
          "response": {"status": "1", "info": "OK", "results": [{"origin_id": "1", "dest_id": "1", "distance": "500", "duration": "360"}]}
        },
        {
          "tool": "maps_distance",
          "args": {"origins": "120.150000,30.270000", "destination": "120.200000,30.320000", "type": "1"},
          "response": {"status": "1", "info": "OK", "results": [{"origin_id": "1", "dest_id": "1", "distance": "4000", "duration": "3000"}]}
        },
        {
          "tool": "maps_direction_walking_by_coordinates",
          "args": {"origin": "120.150000,30.270000", "destination": "120.156000,30.274000"},
          "response": {"status": "1", "info": "OK", "route": {"origin": "120.150000,30.270000", "destination": "120.156000,30.274000", "paths": [{"distance": "720", "duration": "600", "steps": [{"instruction": "向东步行420米"}]}]}}
        },
        {
          "tool": "maps_direction_walking_by_coordinates",
          "args": {"origin": "120.150000,30.270000", "destination": "120.161000,30.279000"},
          "response": {"status": "1", "info": "OK", "route": {"origin": "120.150000,30.270000", "destination": "120.161000,30.279000", "paths": [{"distance": "950", "duration": "780", "steps": [{"instruction": "沿曙光路步行950米"}]}]}}
        },
        {
          "tool": "maps_direction_walking_by_coordinates",
          "args": {"origin": "120.150000,30.270000", "destination": "120.200000,30.320000"},
          "response": {"status": "1", "info": "OK", "route": {"origin": "120.150000,30.270000", "destination": "120.200000,30.320000", "paths": [{"distance": "4300", "duration": "3200", "steps": [{"instruction": "向北步行4300米"}]}]}}
        }
      ],
      "expect": {
        "required_patterns": [["720"], ["950"]],
        "forbidden_patterns": ["500\\s*米", "360\\s*秒", "[^0-9]6\\s*分钟"],
        "no_recommendation_of": ["远山咖啡"],
        "no_question": true,
        "note": "maps_distance(type=1) 返回 500米/360秒，看起来更优，但它是距离测量不是步行路线；只有 720/950 可用。远山咖啡 3200 秒超过 900 秒，不得作为推荐（在说明里写“已排除”是允许的）。"
      }
    },
