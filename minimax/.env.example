# Copy this file to minimax/.env and fill in real values.
# minimax/.env is git-ignored; never commit real credentials.

# --- MiniMax (OpenAI-compatible endpoint) -------------------------------------
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY

# --- seekdb (engineering material store / index) -------------------------------
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=YOUR_SEEKDB_ROOT_PASSWORD
SEEKDB_TENANT=sys
SEEKDB_DATABASE=sdd_context
SEEKDB_CONNECT_TIMEOUT=10
SEEKDB_READ_TIMEOUT=30

# --- PowerContext (task state store) -------------------------------------------
POWERCONTEXT_URL=http://127.0.0.1:8000
POWERCONTEXT_SCOPE=sdd-demo

# --- business project under modification ---------------------------------------
SAMPLE_PROJECT_PATH=minimax/sample_project/jmespath
