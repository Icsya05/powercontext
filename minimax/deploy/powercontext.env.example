# PowerContext Server configuration for the SDD context module.
#
# Copy this file to a location outside the repository (it must not contain a
# real API key in git) and point the server at it:
#
#   powercontext server run --env-file /absolute/path/to/powercontext.env
#
# The committed version below only contains placeholders.

# --- Server transport ---------------------------------------------------------
POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=8000
POWERCONTEXT_SERVER_MCP_ENABLED=true
POWERCONTEXT_SERVER_MCP_PATH=/mcp

# --- Access Control ----------------------------------------------------------
# "disabled" keeps the local run simple: the server only listens on loopback.
POWERCONTEXT_SERVER_ACCESS_MODE=disabled

# --- Database -----------------------------------------------------------------
# Absolute path - a relative SQLite URL silently opens a different database
# after the working directory changes.
POWERCONTEXT_HOME=/absolute/path/to/powercontext-data
POWERCONTEXT_SERVER_DATABASE_KIND=sqlite
POWERCONTEXT_SERVER_DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/powercontext-data/powercontext.db

# --- Inference (MiniMax, OpenAI-compatible) -----------------------------------
# The generation model string is "<provider>:<model>"; PowerContext reads the
# API key from the provider's own environment variable.
POWERCONTEXT_SERVER_INFERENCE_GENERATION_MODEL=openai:YOUR_MODEL_NAME
POWERCONTEXT_SERVER_INFERENCE_GENERATION_BASE_URL=https://api.minimaxi.com/v1
POWERCONTEXT_SERVER_INFERENCE_GENERATION_TIMEOUT_SECONDS=120
OPENAI_API_KEY=YOUR_MINIMAX_API_KEY

# --- Runtime ------------------------------------------------------------------
# The background schedulers are not needed for the verification sample; the
# module drives the server through its HTTP API.
POWERCONTEXT_SERVER_RUNTIME_MEMORY_SCHEDULE_SECONDS=3600
POWERCONTEXT_SERVER_RUNTIME_TOPIC_MEMORY_SCHEDULE_SECONDS=3600
POWERCONTEXT_SERVER_RUNTIME_DREAM_ENABLED=false
