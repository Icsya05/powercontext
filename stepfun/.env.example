# 本地运行配置示例。复制成 stepfun/.env 后按需修改。
# 这里只放占位值，不要提交真实密码。

# --- seekdb 连接（服务端模式） ---
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=28811
SEEKDB_USER=root
SEEKDB_PASSWORD=YOUR_SEEKDB_PASSWORD
SEEKDB_DATABASE=stepfun_kb
SEEKDB_COLLECTION=kb
# 向量维度必须与 embedding 模型一致：
#   Xenova/bge-small-zh-v1.5  -> 512
#   Xenova/all-MiniLM-L6-v2   -> 384
SEEKDB_DIMENSION=512
SEEKDB_DISTANCE=cosine

# --- 本地 HTTP 服务 ---
HOST=127.0.0.1
PORT=8080
# 前端构建产物目录；默认 stepfun/web/dist
# WEB_ROOT=/absolute/path/to/web/dist

# --- 检索参数 ---
SEARCH_NRESULTS=10
# 向量腿候选数（>= 最终返回条数）
SEARCH_KNN_CANDIDATES=30
# 1 = 用 RRF 融合两腿（推荐）；0 = 用分数相加
SEARCH_USE_RRF=1
SEARCH_RRF_WINDOW=60
SEARCH_RRF_CONSTANT=60

# --- 模型 ---
EMBED_MODEL=Xenova/bge-small-zh-v1.5
# 模型下载源（国内网络可换成镜像）
# HF_BASE=https://huggingface.co
